# Copy to .env and fill in. Everything here is optional — without a key the app
# falls back to the keyword analyzer and still runs.

# Enables the LLM and ensemble signal analyzers.
ANTHROPIC_API_KEY=

# Model used for signal analysis.
ANALYZER_MODEL=claude-opus-5

# Live Metaculus comparison. The API returns 403 without a token.
METACULUS_API_TOKEN=

# Days for a signal's influence to halve.
SIGNAL_HALF_LIFE_DAYS=30

# Automatic collection while the server runs. 0 turns it off.
COLLECT_INTERVAL_MINUTES=60
# Stories analyzed per run and per 24 hours. Each one is an analyzer call.
COLLECT_MAX_PER_RUN=2
COLLECT_MAX_PER_DAY=6

# Server port and bind address.
PORT=5000
HOST=0.0.0.0
